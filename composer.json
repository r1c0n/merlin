{
  "name": "recon/merlin",
  "description": "Merlin is an easy way to share files over the web.",
  "authors": [
    {
      "name": "recon"
    }
  ],
  "require": {
    "monolog/monolog": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "Merlin\\": "src/"
    }
  },
  "scripts": {
    "build": [
      "@composer --no-plugins --no-interaction install --no-scripts --no-dev",
      "@composer --no-plugins --no-interaction archive"
    ]
  },
  "scripts-descriptions": {
    "build": "Build project artifact."
  }
}
